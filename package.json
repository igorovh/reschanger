{
  "name": "reschanger",
  "version": "0.1.0",
  "description": "Windows tray utility for quickly changing monitor resolution and refresh rate.",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "author": "reschanger",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:portable": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "pl.reschanger.app",
    "productName": "reschanger",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
